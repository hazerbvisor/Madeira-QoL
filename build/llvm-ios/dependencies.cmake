# Resolve only static libraries used by airconv and Madeira's AGS rewrite.
# Run once all LLVM component targets exist. Map every dependency through the
# component-name mapper: a raw name such as Remarks is also a shared C API target
# and must resolve to LLVMRemarks instead.
function(madeira_llvm_dependencies)
  llvm_map_components_to_libnames(queue passes bitwriter bitreader)
  set(libraries "")
  while(queue)
    list(POP_FRONT queue library)
    if(library IN_LIST libraries)
      continue()
    endif()
    if(NOT TARGET ${library})
      message(FATAL_ERROR "Unresolved DXMT LLVM component: ${library}")
    endif()
    get_target_property(kind ${library} TYPE)
    if(NOT kind STREQUAL "STATIC_LIBRARY")
      message(FATAL_ERROR "DXMT requires a static LLVM component: ${library} (${kind})")
    endif()
    list(APPEND libraries ${library})
    get_target_property(components ${library} LLVM_LINK_COMPONENTS)
    if(components)
      llvm_map_components_to_libnames(dependencies ${components})
      list(APPEND queue ${dependencies})
    endif()
  endwhile()
  set(names "")
  foreach(library IN LISTS libraries)
    string(APPEND names "$<TARGET_FILE_NAME:${library}> ")
  endforeach()
  file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/madeira-libnames" CONTENT "${names}\n")
  string(JOIN " " targets ${libraries})
  file(WRITE "${CMAKE_BINARY_DIR}/madeira-targets" "${targets}\n")
endfunction()
if(CMAKE_CURRENT_SOURCE_DIR STREQUAL CMAKE_SOURCE_DIR)
  cmake_language(DEFER CALL madeira_llvm_dependencies)
endif()
