# Resolve only libraries used by airconv and Madeira's AGS bitcode rewrite.
# Run at the end of LLVM's configure, once all component targets exist.
function(madeira_llvm_dependencies)
  llvm_map_components_to_libnames(roots passes bitwriter bitreader)
  llvm_expand_dependencies(libraries ${roots})
  set(names "")
  set(targets "")
  foreach(library IN LISTS libraries)
    if(NOT TARGET ${library})
      message(FATAL_ERROR "Unresolved DXMT LLVM component: ${library}")
    endif()
    string(APPEND names "lib${library}.a ")
    string(APPEND targets "${library} ")
  endforeach()
  file(WRITE "${CMAKE_BINARY_DIR}/madeira-libnames" "${names}\n")
  file(WRITE "${CMAKE_BINARY_DIR}/madeira-targets" "${targets}\n")
endfunction()
if(CMAKE_CURRENT_SOURCE_DIR STREQUAL CMAKE_SOURCE_DIR)
  cmake_language(DEFER CALL madeira_llvm_dependencies)
endif()
